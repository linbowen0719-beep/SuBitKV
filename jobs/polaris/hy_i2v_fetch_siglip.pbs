#!/bin/bash -l
#PBS -N hy-i2v-siglip
#PBS -A SDR
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# The vision encoder, per checkpoints-download.md:
#   hf download black-forest-labs/FLUX.1-Redux-dev --local-dir ./ckpts/vision_encoder/siglip --token <hf_token>
# The repo is gated (licence acceptance + personal token).  The token is read
# from ${DATA_ROOT}/.hf_token, mode 600, never echoed.  Not substitutable by
# google/siglip-so400m-patch14-384: that ships the full 3.5 GB two-tower model,
# Redux ships an 857 MB vision tower under image_encoder/, and the loader calls
# SiglipVisionModel.from_pretrained(path, subfolder="image_encoder").

set -uo pipefail
ulimit -c 0
DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"
module use /soft/modulefiles; module load conda
export PYTHONNOUSERSITE=1 OPENBLAS_NUM_THREADS=1
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY="${http_proxy}" HTTPS_PROXY="${https_proxy}"
export HF_HOME="${DATA_ROOT}/cache/huggingface"
TOKEN=$(tr -d "[:space:]" < "${QVG_HF_TOKEN_FILE:-${DATA_ROOT}/.hf_token}") || { echo "FATAL: no HF token file"; exit 2; }
HF="${QVG_VENV}/bin/hf"; [ -x "${HF}" ] || HF="${QVG_VENV}/bin/huggingface-cli"
VE="${QVG_HY8B_MODEL}/vision_encoder/siglip"
echo "job: ${PBS_JOBID}  $(date)"
"${HF}" download black-forest-labs/FLUX.1-Redux-dev --local-dir "${VE}" --token "${TOKEN}" 2>&1 | grep -av "${TOKEN}"
RC=0
for p in image_encoder/config.json image_encoder/model.safetensors feature_extractor/preprocessor_config.json; do
  [ -s "${VE}/$p" ] && echo "  ok   $p" || { echo "  MISS $p"; RC=1; }
done
[ "${RC}" -eq 0 ] && echo "SIGLIP READY" || echo "SIGLIP INCOMPLETE"
exit "${RC}"
