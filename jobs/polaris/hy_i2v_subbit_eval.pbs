#!/bin/bash -l
#PBS -N hy-subbit-eval
#PBS -A SDR
#PBS -q prod
#PBS -l select=10:system=polaris
#PBS -l place=scatter
#PBS -l walltime=03:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

set -uo pipefail
ulimit -c 0
export SUBITKV_RUN_ID="${SUBITKV_RUN_ID:-hy-subbit-prod-20260904b}"
DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"
OUT="${SUBITKV_OUTPUT_ROOT}/hyworldplay-moviegen-i2v-20-973/${SUBITKV_RUN_ID}"
REFERENCE="${SUBITKV_OUTPUT_ROOT}/hyworldplay-moviegen-i2v-20-973/hy-main-r1/generation/test/bf16"
TARGET="${OUT}/generation/test/bf16"
if [ ! -e "${TARGET}" ]; then
  ln -s "${REFERENCE}" "${TARGET}"
fi
test -d "${TARGET}"
mpiexec -n 10 -ppn 1 --cpu-bind none \
  /home/czh5/zhenghui/bowen/ICLR2026_RVQ-subbit-hy/jobs/polaris/hy_i2v_subbit_eval_worker.sh
