#!/bin/bash -l
#PBS -N hy-i2v-fixshard
#PBS -A SDR
#PBS -q prod
#PBS -l select=10:system=polaris
#PBS -l place=scatter
#PBS -l walltime=03:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# Repair one shard of the full run on the head node.  Rank 83's node went bad
# during the 100-node round: every missing generation row and the one missing
# evaluation shard are dataset_row % 100 == 83.  Sweep the burned attempts,
# regenerate, then re-evaluate just that shard; aggregate retries afterwards.
# qsub -v SUBITKV_FIX_SHARD=83 hy_i2v_fix_shard.pbs
set -uo pipefail
ulimit -c 0
export DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"
module use /soft/modulefiles; module load conda; module load cudatoolkit-standalone/12.8.1
module load gcc-native/14
export CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14
export PYTHONPATH="${SUBITKV_REPO_ROOT}:${PYTHONPATH:-}" PYTHONNOUSERSITE=1
export OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export HF_HOME="${DATA_ROOT}/cache/huggingface" TRANSFORMERS_CACHE="${DATA_ROOT}/cache/huggingface"
export TORCH_HOME="${DATA_ROOT}/cache/torch" TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY="${http_proxy}" HTTPS_PROXY="${https_proxy}"
export PATH="$(dirname "${SUBITKV_VBENCH}"):${PATH}"

SHARD="${SUBITKV_FIX_SHARD:?}"
RUN_ID="${SUBITKV_RUN_ID:-hy-main-r1}"
OUT="${SUBITKV_OUTPUT_ROOT}/hyworldplay-moviegen-i2v-20-973/${RUN_ID}"
cd "${SUBITKV_REPO_ROOT}"
echo "job ${PBS_JOBID}  fix shard ${SHARD}  host $(hostname -s)  $(date)"

"${SUBITKV_PYTHON}" "${SUBITKV_REPO_ROOT}/jobs/polaris/hy_i2v_sweep_exhausted.py" \
  --generation-root "${OUT}/generation" --split test --stamp "fix${PBS_JOBID%%.*}"

echo "=== generate shard ${SHARD}/100 ==="
"${SUBITKV_PYTHON}" scripts/main/hyworldplay_i2v.py --run-id "${RUN_ID}" --gpus 0,1,2,3 \
  --shard-index "${SHARD}" --num-shards 100 --resume --execute generate --split test --methods all
rc1=$?
echo "=== evaluate shard ${SHARD}/100 ==="
"${SUBITKV_PYTHON}" scripts/main/hyworldplay_i2v.py --run-id "${RUN_ID}" --gpus 0,1,2,3 \
  --shard-index "${SHARD}" --num-shards 100 --resume --execute evaluate --split test --methods all
rc2=$?
echo "=== fix shard ${SHARD} generate rc=${rc1} evaluate rc=${rc2}  $(date) ==="
[ "${rc1}" -eq 0 ] && [ "${rc2}" -eq 0 ]
