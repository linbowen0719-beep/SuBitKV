#!/bin/bash -l
#PBS -N hy-i2v-smoke
#PBS -A SDR
#PBS -q debug-scaling
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# Code-level smoke for the HY-WorldPlay i2v branch: the six pytest modules that
# ship with it, covering the 8B cache codec, append-only KV, capture, the shared
# KV budget, the frozen protocol and the MovieGen prepare step.
#
# On a compute node, not the login node: these exercise CUDA codec paths and
# dump core where there is no GPU.  They need no model weights and no dataset,
# so this runs while the 54 GB asset download is still queued — it validates the
# new code before any of the expensive stages depend on it.
#
# OpenBLAS is capped because Polaris' shared nodes exhaust the thread budget
# otherwise, which surfaces as unrelated-looking import errors.

set -uo pipefail
ulimit -c 0

DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"

module use /soft/modulefiles
module load conda
module load cudatoolkit-standalone/12.8.1
module load gcc-native/14
export CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14

export PYTHONPATH="${QVG_REPO_ROOT}:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

cd "${QVG_REPO_ROOT}"
echo "job: ${PBS_JOBID}  host: $(hostname -s)  $(date)"
nvidia-smi --query-gpu=index,name --format=csv,noheader | sed 's/^/  GPU /'

"${QVG_PYTHON}" -m pytest -q \
  tests/test_hyworldplay8b_cache_codec.py \
  tests/test_hyworldplay_append_only.py \
  tests/test_hyworldplay_capture.py \
  tests/test_hyworldplay_main_protocol.py \
  tests/test_kv_shared_budget.py \
  tests/test_prepare_moviegen_i2v.py
rc=$?
echo "=== smoke rc=${rc}  $(date) ==="
[ "${rc}" -eq 0 ] && echo "SMOKE PASSED" || echo "SMOKE FAILED"
exit "${rc}"
