#!/bin/bash -l
#PBS -N hy-i2v-prod
#PBS -A SDR
#PBS -q prod
#PBS -l select=10:system=polaris
#PBS -l place=scatter
#PBS -l walltime=03:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# 10 nodes x 4 A100 = 40 GPUs for one stage of the 10% pilot.
#
# prod's floor is 10 nodes, so a 1-node stage cannot use it at all; this is the
# shape that fits.  Ten ranks, one per node, each driving its node's four GPUs
# over its own slice of the agreed test set.
#
# Walltime is capped at 3 h because prod routes 10-24 nodes to `small`.  Every
# stage is create-only and resumable, so a stage that needs longer is simply
# resubmitted and continues.
#
# qsub -v SUBITKV_STAGE=generate hy_i2v_prod.pbs
# qsub -v SUBITKV_STAGE=evaluate hy_i2v_prod.pbs

set -uo pipefail
ulimit -c 0

DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"
export SUBITKV_STAGE="${SUBITKV_STAGE:?SUBITKV_STAGE must be passed with qsub -v}"
export SUBITKV_RUN_ID="${SUBITKV_RUN_ID:-hy-main-r1}"
OUT="${SUBITKV_OUTPUT_ROOT}/hyworldplay-moviegen-i2v-20-973/${SUBITKV_RUN_ID}"

echo "job: ${PBS_JOBID}  stage: ${SUBITKV_STAGE}  10 nodes x 4 GPU  $(date)"
mkdir -p "${OUT}"
rm -f "${OUT}"/.status_${SUBITKV_STAGE}_rank*

# One video that burns all three attempts makes every later round exit in
# seconds with "attempt limit exceeded"; hand those rows a fresh budget first.
if [ "${SUBITKV_STAGE}" = "generate" ]; then
  "${SUBITKV_PYTHON}" "${SUBITKV_REPO_ROOT}/jobs/polaris/hy_i2v_sweep_exhausted.py" \
    --generation-root "${OUT}/generation" --split test --stamp "${PBS_JOBID%%.*}"
fi

mpiexec -n 10 -ppn 1 --cpu-bind none \
  "${SUBITKV_REPO_ROOT}/jobs/polaris/hy_i2v_prod_worker.sh"

RC=0
for f in "${OUT}"/.status_${SUBITKV_STAGE}_rank*; do
  [ -f "${f}" ] || continue
  [ "$(cat "${f}")" = "0" ] || { echo "  rank failed: $(basename "${f}")"; RC=1; }
done
echo "=== ${SUBITKV_STAGE} rc=${RC}  $(date) ==="
exit "${RC}"
