#!/bin/bash -l
#PBS -N hy-i2v-evalprobe
#PBS -A SDR
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:40:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# Exercise the evaluate stage's two heavy paths before the chain reaches them,
# using smoke videos that already exist.  Every stage so far has failed on
# something a static read could not reveal (missing wheels, the compiler Triton
# picks, a guard that rejects its own method names), and evaluate is the one
# remaining code path this run has never entered.
#   similarity: cv2 + lpips(VGG, downloads weights on first use) + SSIM
#   vbench:     the py311 CLI and its 4.4 GB weight cache
set -uo pipefail
ulimit -c 0
DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"
module use /soft/modulefiles; module load conda; module load cudatoolkit-standalone/12.8.1
module load gcc-native/14
export CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14
export PYTHONPATH="${SUBITKV_REPO_ROOT}:${PYTHONPATH:-}" PYTHONNOUSERSITE=1
export OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2
export HF_HOME="${DATA_ROOT}/cache/huggingface" TORCH_HOME="${DATA_ROOT}/cache/torch"
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY="${http_proxy}" HTTPS_PROXY="${https_proxy}"
mkdir -p "${TORCH_HOME}"
S="${SUBITKV_OUTPUT_ROOT}/hyworldplay-moviegen-i2v-20-973/hy-main-r1/smoke/one_chunk"
PROBE="${DATA_ROOT}/tmp/eval_probe"; rm -rf "${PROBE}"; mkdir -p "${PROBE}"
echo "job ${PBS_JOBID} host $(hostname -s) $(date)"

echo "=== 1/2 similarity path (cv2 + lpips VGG + ssim) ==="
cd "${SUBITKV_REPO_ROOT}"
"${SUBITKV_PYTHON}" - <<'PYEOF'
import os, glob, torch, cv2, lpips, time
from scripts.eval.compare_video_quality import calculate_ssim, to_frame_tensor
S = os.path.join(os.environ["SUBITKV_OUTPUT_ROOT"], "hyworldplay-moviegen-i2v-20-973/hy-main-r1/smoke/one_chunk")
ref = sorted(glob.glob(f"{S}/bf16/attempt_*/job/gen.mp4"))[-1]
tst = sorted(glob.glob(f"{S}/ours_rvq_avg2/attempt_*/job/gen.mp4"))[-1]
print("  ref:", os.path.basename(os.path.dirname(os.path.dirname(ref))), "| tst: ours_rvq_avg2", flush=True)
t0 = time.time()
model = lpips.LPIPS(net="vgg").to("cuda").eval()
print(f"  lpips(VGG) loaded in {time.time()-t0:.1f}s", flush=True)
def frames(p, n=4):
    cap = cv2.VideoCapture(p); out = []
    while len(out) < n:
        ok, f = cap.read()
        if not ok: break
        out.append(f)
    cap.release(); return out
fa, fb = frames(ref), frames(tst)
print(f"  decoded {len(fa)} / {len(fb)} frames", flush=True)
assert fa and fb, "no frames decoded"
import numpy as np
mse = float(np.mean((fa[0].astype("f4") - fb[0].astype("f4")) ** 2))
psnr = 10 * np.log10(255.0**2 / mse) if mse > 0 else float("inf")
ss = calculate_ssim(fa[0], fb[0])
ta, tb = to_frame_tensor(fa[0]).to("cuda"), to_frame_tensor(fb[0]).to("cuda")
with torch.no_grad():
    lp = float(model(ta * 2 - 1, tb * 2 - 1).item())
print(f"  PSNR={psnr:.2f} dB  SSIM={ss if isinstance(ss,float) else ss}  LPIPS={lp:.4f}")
print("  SIMILARITY PATH OK", flush=True)
PYEOF
rc1=$?; echo "  similarity rc=${rc1}"

echo "=== 2/2 vbench path (1 dimension, 1 video) ==="
mkdir -p "${PROBE}/videos"
cp "$(ls -t ${S}/bf16/attempt_*/job/gen.mp4 | head -1)" "${PROBE}/videos/probe-0.mp4"
printf 'a short test clip\n' > "${PROBE}/prompts.txt"
echo "  VBENCH_CACHE_DIR=${VBENCH_CACHE_DIR}"
timeout 1200 "${SUBITKV_VBENCH}" evaluate --ngpus 1 --output_path "${PROBE}/out" \
  --videos_path "${PROBE}/videos" --dimension subject_consistency \
  --mode custom_input --prompt_file "${PROBE}/prompts.txt" 2>&1 | tail -12
rc2=$?
ls "${PROBE}/out" 2>/dev/null | sed 's/^/    /'
echo "  vbench rc=${rc2}"
[ "${rc1}" -eq 0 ] && [ "${rc2}" -eq 0 ] && echo "EVAL PROBE PASSED" || echo "EVAL PROBE FAILED sim=${rc1} vbench=${rc2}"
