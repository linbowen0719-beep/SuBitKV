#!/bin/bash -l
#PBS -N hy-i2v-evalfull
#PBS -A SDR
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# Full dry run of the evaluate stage against a synthetic generation tree built
# from smoke videos, so the real chain does not discover these failures at 06:00.
# Covers what the earlier probe did not: the actual
# evaluate_moviegen_i2v_dataset.py entry point, all four VBench dimensions, and
# the aggregation helpers that read the results back.
# Everything is written under tmp/eval_probe_full -- the real output tree is
# only ever read.
set -uo pipefail
ulimit -c 0
export DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"
module use /soft/modulefiles; module load conda; module load cudatoolkit-standalone/12.8.1
module load gcc-native/14
export CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14
export PYTHONPATH="${SUBITKV_REPO_ROOT}:${PYTHONPATH:-}" PYTHONNOUSERSITE=1
export OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2
export HF_HOME="${DATA_ROOT}/cache/huggingface" TORCH_HOME="${DATA_ROOT}/cache/torch"
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY="${http_proxy}" HTTPS_PROXY="${https_proxy}"
mkdir -p "${TORCH_HOME}"
# VBench shells out to a bare `python`; its own venv bin must be on PATH.
export PATH="$(dirname "${SUBITKV_VBENCH}"):${PATH}"

REAL="${SUBITKV_OUTPUT_ROOT}/hyworldplay-moviegen-i2v-20-973/hy-main-r1"
S="${REAL}/smoke/one_chunk"
P="${DATA_ROOT}/tmp/eval_probe_full"
rm -rf "${P}"; mkdir -p "${P}/generation"
echo "job ${PBS_JOBID} host $(hostname -s) $(date)"
cd "${SUBITKV_REPO_ROOT}"

echo "=== 0/3 build synthetic generation tree from smoke videos ==="
"${SUBITKV_PYTHON}" - <<'PYEOF'
import json, os, shutil, glob
from pathlib import Path
P = Path(os.environ["DATA_ROOT"]) / "tmp/eval_probe_full"
S = Path(os.environ["SUBITKV_OUTPUT_ROOT"]) / "hyworldplay-moviegen-i2v-20-973/hy-main-r1/smoke/one_chunk"
man = json.load(open(Path(os.environ["SUBITKV_DATA_ROOT"]) / "hyworldplay-moviegen-i2v-20-973/artifacts/inputs/manifest.json"))
rows = [r["dataset_row"] for r in man["records"] if r["split"] == "dev"]
methods = ["bf16", "ours_rvq_avg2", "kivi_int2"]
for m in methods:
    src = sorted(glob.glob(str(S / m / "attempt_*/job")))
    assert src, f"no smoke job for {m}"
    src = Path(src[-1])
    for r in rows:
        dst = P / "generation/dev" / m / f"row_{r:04d}/attempt_01/job"
        dst.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src / "gen.mp4", dst / "gen.mp4")
        res = json.load(open(src / "result.json"))
        res["dataset_row"] = r
        json.dump(res, open(dst / "result.json", "w"), indent=2)
        for extra in ("generation_metrics.json", "config.json", "run_info.json"):
            if (src / extra).is_file():
                shutil.copy2(src / extra, dst / extra)
print(f"  built {len(methods)} methods x {len(rows)} rows", flush=True)
PYEOF
[ $? -eq 0 ] || { echo "PROBE FAILED at tree build"; exit 1; }

echo "=== 1/3 real evaluate_moviegen_i2v_dataset.py (2 methods) ==="
rc1=0
for m in ours_rvq_avg2 kivi_int2; do
  echo "  --- ${m} ---"
  "${SUBITKV_PYTHON}" scripts/HY-WorldPlay/evaluate_moviegen_i2v_dataset.py \
    --generation-root "${P}/generation" \
    --manifest "${SUBITKV_DATA_ROOT}/hyworldplay-moviegen-i2v-20-973/artifacts/inputs/manifest.json" \
    --split dev --method "${m}" --output-dir "${P}/evaluation/${m}" \
    --device cuda --codebook-root "${SUBITKV_DATA_ROOT}/hyworldplay-moviegen-i2v-20-973/artifacts" 2>&1 | tail -6
  r=${PIPESTATUS[0]}; [ "${r}" -ne 0 ] && rc1=1
  echo "    rc=${r}"
done
ls "${P}/evaluation"/*/ 2>/dev/null | head -6 | sed 's/^/    /'

echo "=== 2/3 all four VBench dimensions ==="
mkdir -p "${P}/vb/videos"
cp "$(ls -t ${S}/bf16/attempt_*/job/gen.mp4 | head -1)" "${P}/vb/videos/probe-0.mp4"
printf 'a short test clip\n' > "${P}/vb/prompts.txt"
rc2=0
for dim in subject_consistency background_consistency imaging_quality aesthetic_quality; do
  echo "  --- ${dim} ---"
  timeout 900 "${SUBITKV_VBENCH}" evaluate --ngpus 1 --output_path "${P}/vb/out_${dim}" \
    --videos_path "${P}/vb/videos" --dimension "${dim}" \
    --mode custom_input --prompt_file "${P}/vb/prompts.txt" 2>&1 | tail -4
  r=${PIPESTATUS[0]}; [ "${r}" -ne 0 ] && rc2=1
  echo "    rc=${r}  files: $(ls ${P}/vb/out_${dim} 2>/dev/null | tr '\n' ' ')"
done

echo "=== 3/3 aggregation helpers read the results back ==="
"${SUBITKV_PYTHON}" - <<'PYEOF'
import json, os, sys, glob
from pathlib import Path
sys.path.insert(0, os.environ["SUBITKV_REPO_ROOT"])
P = Path(os.environ["DATA_ROOT"]) / "tmp/eval_probe_full"
ok = True
for m in ("ours_rvq_avg2", "kivi_int2"):
    f = sorted(glob.glob(str(P / "evaluation" / m / "**/*.json"), recursive=True))
    print(f"  {m}: {len(f)} json ->", [Path(x).name for x in f][:4])
    if not f: ok = False
for dim in ("subject_consistency", "background_consistency", "imaging_quality", "aesthetic_quality"):
    f = sorted(glob.glob(str(P / f"vb/out_{dim}/**/*.json"), recursive=True))
    vals = []
    for x in f:
        try:
            d = json.load(open(x))
            if isinstance(d, dict):
                for k, v in d.items():
                    if isinstance(v, (int, float)): vals.append((k, v))
                    elif isinstance(v, list) and v and isinstance(v[0], (int, float)): vals.append((k, v[0]))
        except Exception: pass
    print(f"  {dim}: {len(f)} json, 分值 {vals[:2]}")
    if not f: ok = False
print("  AGGREGATION READBACK", "OK" if ok else "INCOMPLETE")
PYEOF
rc3=$?
echo "=== 结果 ==="
[ "${rc1}" -eq 0 ] && [ "${rc2}" -eq 0 ] && [ "${rc3}" -eq 0 ] \
  && echo "EVAL FULL PROBE PASSED" \
  || echo "EVAL FULL PROBE FAILED similarity=${rc1} vbench=${rc2} aggregate=${rc3}"
