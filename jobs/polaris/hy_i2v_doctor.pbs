#!/bin/bash -l
#PBS -N hy-i2v-doctor
#PBS -A SDR
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris/logs/

# First real step of the HY-WorldPlay 8B MovieGen i2v 20/10/973 pipeline.
#
# `doctor --execute` is the only stage that can run before the checkpoints and
# the MovieGen dataset are staged, and it is the prerequisite for every stage
# after it: it verifies the tool chain and claims the GPUs through the
# pipeline's exclusive lock (no compute process, <=512 MiB used, <=5% util per
# card).  Running it on a compute node exercises that claim path for real,
# which a login node cannot — there is no GPU there and doctor reports
# CalledProcessError for all eight.
#
# Polaris has 4 GPUs per node, not the 8 the docs assume, so --gpus is 0,1,2,3.
#
# It is expected to report status "failed" until Bowen supplies
# HunyuanVideo-1.5, ar_distilled_action_model and the MovieGen dataset; the
# value of running it now is the precise, machine-checked list of what is
# missing plus proof that everything else is ready.

set -uo pipefail
ulimit -c 0

DATA_ROOT=/lus/grand/projects/SDR/chengming/zhenghui/ICLR2026_RVQ_polaris
. "${DATA_ROOT}/hy_i2v.env"

module use /soft/modulefiles
module load conda
module load cudatoolkit-standalone/12.8.1
module load gcc-native/14
export CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14

export PYTHONPATH="${QVG_REPO_ROOT}:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY="${http_proxy}" HTTPS_PROXY="${https_proxy}"

RUN_ID="${QVG_RUN_ID:-hy-main-r1}"
cd "${QVG_REPO_ROOT}"
echo "job: ${PBS_JOBID}  host: $(hostname -s)  run: ${RUN_ID}  $(date)"
nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader | sed 's/^/  GPU /'

echo "=== doctor (dry run) ==="
"${QVG_PYTHON}" scripts/main/hyworldplay_i2v.py --run-id "${RUN_ID}" --gpus 0,1,2,3 doctor
echo "=== doctor --execute ==="
"${QVG_PYTHON}" scripts/main/hyworldplay_i2v.py --run-id "${RUN_ID}" --gpus 0,1,2,3 --execute doctor
rc=$?
echo "=== doctor rc=${rc}  $(date) ==="
exit 0
