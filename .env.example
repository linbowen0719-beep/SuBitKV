# Copy this file to .env and replace the paths for your machine.
# Relative paths are resolved from the repository root.
SUBITKV_CKPT_ROOT=ckpts
SUBITKV_DATA_ROOT=data
SUBITKV_CODEBOOK_ROOT=codebooks
SUBITKV_OUTPUT_ROOT=outputs/reproduction
SUBITKV_CACHE_ROOT=.cache

# HY-WorldPlay 8B MovieGen I2V protocol.
SUBITKV_MOVIEGEN_ROOT=data/movie_gen_video_bench
SUBITKV_HY8B_MODEL=ckpts/HunyuanVideo-1.5
SUBITKV_HY_ACTION_CKPT=ckpts/HY-WorldPlay/ar_distilled_action_model/model.safetensors
# SUBITKV_PYTHON=/path/to/hyworldplay/bin/python
# SUBITKV_FFMPEG=ffmpeg
# SUBITKV_FFPROBE=ffprobe
# SUBITKV_VBENCH=vbench

# Optional Hugging Face cache override.
# HF_HOME=.cache/huggingface

# Optional runtime overrides.
# CUDA_VISIBLE_DEVICES=0
# NPROC_PER_NODE=1

# Public five-stage SuBitKV workflow (optional).
# SUBITKV_ROOT=outputs/subitkv
# SUBITKV_IMAGES=data/subitkv/images
