# Copy this file to .env and replace the paths for your machine.
# Relative paths are resolved from the repository root.
QVG_CKPT_ROOT=ckpts
QVG_DATA_ROOT=data
QVG_CODEBOOK_ROOT=codebooks
QVG_OUTPUT_ROOT=outputs/reproduction
QVG_CACHE_ROOT=.cache

# HY-WorldPlay 8B MovieGen I2V protocol.
QVG_MOVIEGEN_ROOT=data/movie_gen_video_bench
QVG_HY8B_MODEL=ckpts/HunyuanVideo-1.5
QVG_HY_ACTION_CKPT=ckpts/HY-WorldPlay/ar_distilled_action_model/model.safetensors
# QVG_PYTHON=/path/to/hyworldplay/bin/python
# QVG_FFMPEG=ffmpeg
# QVG_FFPROBE=ffprobe
# QVG_VBENCH=vbench

# Optional Hugging Face cache override.
# HF_HOME=.cache/huggingface

# Optional runtime overrides.
# CUDA_VISIBLE_DEVICES=0
# NPROC_PER_NODE=1
