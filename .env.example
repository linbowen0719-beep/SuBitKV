# Copy this file to .env and replace the paths for your machine.
# Relative paths are resolved from the repository root.
QVG_CKPT_ROOT=ckpts
QVG_DATA_ROOT=data
QVG_CODEBOOK_ROOT=codebooks
QVG_OUTPUT_ROOT=outputs/reproduction
QVG_CACHE_ROOT=.cache

# Optional Hugging Face cache override.
# HF_HOME=.cache/huggingface

# Optional runtime overrides.
# CUDA_VISIBLE_DEVICES=0
# NPROC_PER_NODE=1
